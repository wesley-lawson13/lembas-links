# EXAMPLE — on lembas-app, copy this to `.env` (exact name, next to
# docker-compose.app.yml) — Compose only auto-loads a file named ".env".
# Do NOT copy the local .env here — it contains a commented plaintext dev key
# and points at localhost, not the data box's private IP.

# Data box's private IP (stable for the instance's life; changes only on
# terminate/recreate — see db.lembas.internal / Route 53 private zone in Week 2).
DATABASE_URL=postgres://<user>:<password>@<data-private-ip>:5432/<db>?sslmode=disable
REDIS_URL=redis://:<redis-password>@<data-private-ip>:6379

# Public origin — the app box's Elastic IP (or domain once one exists).
# Unvalidated at startup: leaving this empty ships malformed short URLs.
BASE_URL=http://<app-elastic-ip>

# Same-origin deploy (nginx proxies both SPA and API) — leave empty so
# api/main.go skips registering CORS middleware entirely.
CORS_ALLOWED_ORIGINS=

API_PORT=8080
GIN_MODE=release

# Rate Limiting Vars
IP_RATE_LIMIT=60
KEY_RATE_LIMIT=120
RATE_LIMIT_WINDOW=60
DEFAULT_TTL_DAYS=30
SESSION_RATE_LIMIT=5
SESSION_RATE_LIMIT_WINDOW=3600

# Analytics
RECENT_CLICKS_LIMIT=10
