# EXAMPLE .env file

# Database — set these 3 variables and update the DATABASE_URL
# with these variables to minimally run the application, keeping the
# sslmode=disable at the end (ONLY for)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgres://<user>:<password>@postgres:5432/<db>?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379

# Base URL — used to build the short links returned by the API.
# Not validated at startup: if left empty the API boots fine but returns
# malformed short URLs like "/gandalf-shadow-flame". Use the API's public
# origin; for local Docker Compose that's http://localhost:8080
BASE_URL=http://localhost:8080

# API
API_PORT=8080

# Rate Limiting Vars
IP_RATE_LIMIT=60
KEY_RATE_LIMIT=120
RATE_LIMIT_WINDOW=60
DEFAULT_TTL_DAYS=30
SESSION_RATE_LIMIT=5
SESSION_RATE_LIMIT_WINDOW=3600

# Analytics
RECENT_CLICKS_LIMIT=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Testing database URL
TEST_DATABASE_URL=

# Testing redis URL
TEST_REDIS_URL=
