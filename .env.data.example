# EXAMPLE — on lembas-data, copy this to `.env` (exact name, next to
# docker-compose.data.yml) — Compose only auto-loads a file named ".env",
# both for container env vars AND for ${PRIVATE_IP}/${REDIS_PASSWORD}
# substitution in the compose file itself.
# Generate POSTGRES_PASSWORD and REDIS_PASSWORD (e.g. `openssl rand -base64 24`)
# — do not reuse the memorable local-dev password.

POSTGRES_USER=lembas
POSTGRES_PASSWORD=<generated>
POSTGRES_DB=lembas_links

REDIS_PASSWORD=<generated>

# This box's private IP — postgres/redis bind here, never 0.0.0.0.
# `curl -s http://169.254.169.254/latest/meta-data/local-ipv4` from the box.
PRIVATE_IP=<data-box-private-ip>
