# EXAMPLE .env file

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgres://<user>:<password>@postgres:5432/<db>

# Redis
REDIS_URL=redis://redis:6379

# Base URL
BASE_URL=

# API
API_PORT=8080
API_SECRET_KEY=

# NLP Service
NLP_SERVICE_URL=http://nlp-service:8000

# Rate Limiting Vars
IP_RATE_LIMIT=60
KEY_RATE_LIMIT=120
RATE_LIMIT_WINDOW=60
DEFAULT_TTL_DAYS=30
SESSION_RATE_LIMIT=5
SESSION_RATE_LIMIT_WINDOW=3600

# Analytics
RECENT_CLICKS_LIMIT=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Testing database URL
TEST_DATABASE_URL=

# Testing redis URL
TEST_REDIS_URL=
